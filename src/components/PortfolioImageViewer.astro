---
import IconX from "@/assets/icons/IconX.svg";
import type { Locale } from "@/utils/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const closeLabel = locale === "he" ? "סגירת התמונה" : "Close image";
---

<dialog id="portfolio-image-viewer" aria-label={locale === "he" ? "תמונה מוגדלת" : "Enlarged image"}>
  <form method="dialog">
    <button type="submit" aria-label={closeLabel} title={closeLabel} autofocus><IconX /></button>
  </form>
  <img alt="" />
</dialog>

<script>
  // Delegation survives Astro's client-side page swaps without duplicate bindings.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const dialog = document.querySelector<HTMLDialogElement>("#portfolio-image-viewer");
    if (!dialog) return;

    if (event.target === dialog && dialog.open) {
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right ||
          event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      return;
    }

    const link = event.target.closest<HTMLAnchorElement>("a[data-portfolio-image]");
    if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const thumbnail = link.querySelector("img");
    const image = dialog.querySelector("img");
    if (!thumbnail || !image) return;
    event.preventDefault();
    image.src = link.href;
    image.alt = thumbnail.alt;
    dialog.showModal();
    dialog.addEventListener("close", () => link.isConnected && link.focus({ preventScroll: true }), { once: true });
  }, { capture: true });

  document.addEventListener("astro:before-swap", () => {
    document.querySelector<HTMLDialogElement>("#portfolio-image-viewer[open]")?.close();
  });
</script>

<style>
  dialog { margin: auto; padding: 16px; width: fit-content; max-width: calc(100vw - 32px); max-height: calc(100dvh - 32px); border: 1px solid var(--border); border-radius: 8px; background: var(--background); color: var(--foreground); }
  dialog::backdrop { background: rgb(0 0 0 / .8); }
  form { display: flex; justify-content: flex-end; margin: 0 0 8px; }
  button { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 4px; cursor: pointer; }
  button:hover { background: var(--foreground); color: var(--background); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  button svg { width: 24px; height: 24px; }
  img { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(100dvh - 120px); object-fit: contain; margin-inline: auto; }
  :global(html:has(#portfolio-image-viewer[open])) { overflow: hidden; }
</style>

---
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconX from "@/assets/icons/IconX.svg";
import { SITE } from "@/config";
import {
  alternateLocale,
  alternateLocalePath,
  getLocale,
  localizedPath,
  localeMeta,
  stripLocale,
} from "@/utils/i18n";
import Hr from "./Hr.astro";
import LinkButton from "./LinkButton.astro";

const { pathname } = Astro.url;
const locale = getLocale(pathname);
const otherLocale = alternateLocale(locale);
const labels = {
  en: {
    brand: SITE.title,
    skip: "Skip to content",
    posts: "Posts",
    portfolio: "Portfolio",
    about: "About",
    search: "Search",
    openMenu: "Open Menu",
    closeMenu: "Close Menu",
    theme: "Toggles light & dark",
    language: "Switch to Hebrew",
  },
  he: {
    brand: "עומרי בן צבי",
    skip: "דלג לתוכן",
    posts: "פוסטים",
    portfolio: "תיק עבודות",
    about: "אודות",
    search: "חיפוש",
    openMenu: "פתח תפריט",
    closeMenu: "סגור תפריט",
    theme: "החלפת מצב בהיר וכהה",
    language: "Switch to English",
  },
}[locale];

// Remove trailing slash from current pathname if exists
const currentPath = pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = stripLocale(currentPath).split("/").filter((p) => p.trim());
  const pathArray = stripLocale(path).split("/").filter((p) => p.trim());

  return stripLocale(currentPath) === stripLocale(path) || currentPathArray[0] === pathArray[0];
};
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute -top-full left-16 z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    {labels.skip}
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-3xl flex-col items-center justify-between md:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-baseline justify-between bg-background p-4 md:items-center md:py-6"
    >
      <a
        href={localizedPath("/", locale)}
        class="absolute py-1 text-2xl leading-7 font-semibold whitespace-nowrap md:static"
      >
        {labels.brand}
      </a>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center md:ml-2 md:flex-row md:justify-end md:space-x-4 md:py-0"
      >
        <button
          id="menu-btn"
          class="focus-outline self-end p-2 md:hidden"
          aria-label={labels.openMenu}
          aria-expanded="false"
          aria-controls="menu-items"
          data-open-label={labels.openMenu}
          data-close-label={labels.closeMenu}
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class:list={[
            "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent md:[&>li>a]:px-2 md:[&>li>a]:py-1",
            "hidden",
            "md:mt-0 md:ml-0 md:flex md:w-auto md:gap-x-5 md:gap-y-0",
          ]}
        >
          <li class="col-span-2">
            <a
              href={localizedPath("/portfolio", locale)}
              class:list={{ "active-nav": isActive(localizedPath("/portfolio", locale)) }}
            >
              {labels.portfolio}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={localizedPath("/posts", locale)}
              class:list={{ "active-nav": isActive(localizedPath("/posts", locale)) }}
            >
              {labels.posts}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={localizedPath("/about", locale)}
              class:list={{ "active-nav": isActive(localizedPath("/about", locale)) }}
            >
              {labels.about}
            </a>
          </li>
          <li class="col-span-1 flex items-center justify-center">
            <LinkButton
              href={localizedPath("/search", locale)}
              class:list={[
                "focus-outline flex p-3 md:p-1",
                { "[&>svg]:stroke-accent": isActive(localizedPath("/search", locale)) },
              ]}
              ariaLabel={labels.search.toLowerCase()}
              title={labels.search}
            >
              <IconSearch />
              <span class="sr-only">{labels.search}</span>
            </LinkButton>
          </li>
          <li class="col-span-1 flex items-center justify-center">
            <a
              href={alternateLocalePath(pathname)}
              class="focus-outline flex size-12 items-center justify-center p-3 text-sm font-semibold hover:text-accent md:size-8 md:p-1"
              hreflang={localeMeta[otherLocale].lang}
              lang={localeMeta[otherLocale].lang}
              title={labels.language}
              aria-label={labels.language}
              data-analytics-event="language_switch"
              data-analytics-label={locale}
              data-analytics-target={otherLocale}
            >
              {localeMeta[otherLocale].shortLabel}
            </a>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 p-4 md:size-8 hover:[&>svg]:stroke-accent"
                  title={labels.theme}
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<script>
  function getNavParts() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return null;

    return { menuBtn, menuItems, menuIcon, closeIcon };
  }

  function resetNav() {
    const parts = getNavParts();
    if (!parts) return;

    const { menuBtn, menuItems, menuIcon, closeIcon } = parts;
    menuBtn.setAttribute("aria-expanded", "false");
    menuBtn.setAttribute("aria-label", menuBtn.dataset.openLabel || "Open Menu");
    menuItems.classList.add("hidden");
    menuIcon.classList.remove("hidden");
    closeIcon.classList.add("hidden");
  }

  function toggleNav() {
    const parts = getNavParts();
    if (!parts) return;

    const { menuBtn, menuItems, menuIcon, closeIcon } = parts;
    const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

    menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
    menuBtn.setAttribute(
      "aria-label",
      openMenu ? menuBtn.dataset.openLabel || "Open Menu" : menuBtn.dataset.closeLabel || "Close Menu",
    );

    menuItems.classList.toggle("hidden");
    menuIcon.classList.toggle("hidden");
    closeIcon.classList.toggle("hidden");
  }

  if (!window.__omribzMenuHandler) {
    window.__omribzMenuHandler = true;
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest("#menu-btn")) return;
      toggleNav();
    });
    document.addEventListener("astro:page-load", resetNav);
  }
</script>

{
  "name": "omribz-me",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && pnpm run build:site",
    "build:check": "pnpm run build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "astro sync",
    "lint": "oxlint --deny-warnings --import-plugin --react-plugin src scripts tests astro.config.mjs playwright.config.ts",
    "lint:fix": "oxlint --fix --deny-warnings --import-plugin --react-plugin src scripts tests astro.config.mjs playwright.config.ts",
    "format": "oxfmt --write 'src/**/*.{js,mjs,cjs,ts,tsx,json}' scripts tests astro.config.mjs playwright.config.ts package.json vercel.json tsconfig.json",
    "format:check": "oxfmt --check 'src/**/*.{js,mjs,cjs,ts,tsx,json}' scripts tests astro.config.mjs playwright.config.ts package.json vercel.json tsconfig.json",
    "check": "pnpm run format:check && pnpm run lint",
    "check:fix": "pnpm run format && pnpm run lint:fix",
    "prepare": "husky",
    "build:site": "astro build && node scripts/secure-html.mjs && pagefind --site dist",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:publication": "node tests/publication-build.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@pagefind/default-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^7.3.8",
    "astro-embed": "^0.14.0",
    "dayjs": "^1.11.23",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "lodash.kebabcase": "^4.1.1",
    "pagefind": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.29"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "lodash@<4.18.0": "^4.18.0",
      "serialize-javascript@<7.0.5": "^7.0.5",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9"
    }
  }
}
